{
  "name": "shop-api",
  "version": "1.0.0",
  "description": "Minimal Express shopping-cart API with JWT auth and better-sqlite3, written in TypeScript and bundled with tsdown",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsdown",
    "seed": "node dist/seed.js",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsdown": "^0.9.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  }
}
